{
  "expo": {
    "name": "TellYouTo",
    "slug": "tellyouto",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "tellyouto",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F5F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "TellYouTo lit tes créneaux occupés sur l’appareil pour le rail — aucun titre d’événement n’est envoyé au nuage."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F0",
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
