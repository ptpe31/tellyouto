{
  "expo": {
    "name": "TalknDone",
    "slug": "talkndone",
    "version": "1.0.0",
    "scheme": "talkndone",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La position est utilisée pour estimer le temps de trajet et afficher une fenêtre de départ sereine.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Surveillance du trafic en temps réel pour optimiser l'horaire de départ vers vos rendez-vous. La position n'est utilisée que pendant une mission trajet active.",
        "LSApplicationQueriesSchemes": [
          "waze",
          "comgooglemaps",
          "clock-alarm",
          "clock-worldclock"
        ],
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "fetch",
          "processing"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "bundleIdentifier": "com.trankil.talkndone"
    },
    "android": {
      "package": "com.trankil.talkndone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "queries": [
        {
          "intent": [
            {
              "action": "android.intent.action.SET_ALARM"
            },
            {
              "action": "android.intent.action.SHOW_ALARMS"
            }
          ]
        },
        {
          "package": "com.google.android.deskclock"
        },
        {
          "package": "com.sec.android.app.clockpackage"
        },
        {
          "package": "com.android.deskclock"
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ],
      "expo-speech-recognition",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La position est utilisée pour estimer le temps de trajet et afficher une fenêtre de départ sereine.",
          "locationAlwaysAndWhenInUsePermission": "Surveillance du trafic en temps réel pour optimiser l'horaire de départ vers vos rendez-vous.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "departure_contract_signals",
          "enableBackgroundRemoteNotifications": true,
          "mode": "development"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8d93ab6d-ec6e-4880-b40d-9dffa6a8f57f"
      }
    }
  }
}
