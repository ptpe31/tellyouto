# Copier vers .env (non versionné) ou définir les mêmes clés dans EAS (Secrets / Environment).
# Préfixe EXPO_PUBLIC_* : inclus dans le bundle client — ne pas y mettre de secrets serveur.

EXPO_PUBLIC_APP_ENV=production

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Bots (canal privé — URLs ouvertes dans l’app, pas des secrets)
EXPO_PUBLIC_BOT_WHATSAPP_URL=
# Numéro WhatsApp du bot (international sans +) — wa.me/{num}?text=…
EXPO_PUBLIC_WHATSAPP_BOT_NUMBER=33648259341
EXPO_PUBLIC_BOT_TELEGRAM_URL=https://t.me/TellYouToBot
# Nom du bot Telegram (sans @) — aligné sur TELEGRAM_BOT_NAME côté Functions
EXPO_PUBLIC_TELEGRAM_BOT_NAME=TellYouToBot
# Alias supporté par le code
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=TellYouToBot
EXPO_PUBLIC_BOT_SLACK_URL=
EXPO_PUBLIC_BOT_LINE_URL=

# Optionnel
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# URL HTTPS de la Cloud Function `disconnectMessenger` (déconnexion messagerie depuis l’app)
# EXPO_PUBLIC_DISCONNECT_MESSENGER_URL=https://REGION-PROJECT.cloudfunctions.net/disconnectMessenger
# Même valeur secrète que BOT_WEBHOOK_SECRET côté Functions (si défini) — exposée au client uniquement si tu acceptes ce compromis
# EXPO_PUBLIC_BOT_WEBHOOK_SECRET=

# Cloud Functions (webhook bots) — ne pas mettre dans le bundle client
# Telegram Bot API (@BotFather) — secrets réservés au backend / Firebase Config / Secret Manager
# Obligatoire pour telegramWebhook et l’envoi de messages :
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_NAME=TellYouToBot
# Jeton partagé avec setWebhook (en-tête X-Telegram-Bot-Api-Secret-Token sur chaque update)
# TELEGRAM_WEBHOOK_SECRET=
# URL complète de la fonction telegramWebhook (pour le script npm run set-telegram-webhook dans functions/)
# TELEGRAM_WEBHOOK_URL=https://REGION-PROJECT.cloudfunctions.net/telegramWebhook
# ALLOW_INSECURE_TELEGRAM_WEBHOOK=1  # local uniquement — désactive la vérif du secret Telegram
# BOT_WEBHOOK_SECRET=
# WhatsApp Cloud API (réponses automatiques — accueil + accusés)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
