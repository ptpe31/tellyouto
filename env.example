# Copier vers .env : cp env.example .env
# EXPO_PUBLIC_* = exposé au client — ne pas versionner .env

# Firebase (production)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mapbox Search Box (recherche d'adresses — prod) site: https://console.mapbox.com/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Places (legacy — uniquement si MAP_PROVIDER=google dans mapConfig.ts)
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Google Distance Matrix (trafic Sentinel — optionnel, fallback clé Places)
# EXPO_PUBLIC_GOOGLE_DISTANCE_MATRIX_API_KEY=

# Mode Solo Local (dev)
# EXPO_PUBLIC_LOCAL_MODE=true
# EXPO_PUBLIC_GEMINI_API_KEY=
