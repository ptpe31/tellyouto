rules_version = '2';

// Authentification requise (y compris anonyme : request.auth != null).
// Périmètre : devices (+ intentions & rail_inbox transit) + tests de connexion.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /devices/{deviceId} {
      allow read, write: if signedIn();

      match /intentions/{intentionId} {
        allow read, write: if signedIn();
      }

      match /rail_inbox/{docId} {
        allow read, write: if signedIn();
      }
    }

    match /CONNECTION_TESTS/{docId} {
      allow read, write: if signedIn();
    }

    // Refus explicite du reste (évite l’accès large par erreur).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
